<?xml version="1.0"?>
<robot name="tuto">

  <!-- ================================= LINKS ================================= -->

  <!-- Base Link (Chassis) -->
  <link name="link_0">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1"/>
      <inertia ixx="0.166667" ixy="0" ixz="0" iyy="0.166667" iyz="0" izz="0.166667"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="1.5 1 0.4"/>
      </geometry>
      <material name="grey">
        <color rgba="0.7 0.7 0.7 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="1.5 1 0.4"/>
      </geometry>
    </collision>
  </link>

  <!-- Left Wheel Link -->
  <link name="link_1">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1"/>
      <inertia ixx="0.145833" ixy="0" ixz="0" iyy="0.145833" iyz="0" izz="0.125"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.25" radius="0.3"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.25" radius="0.3"/>
      </geometry>
    </collision>
  </link>

  <!-- Right Wheel Link -->
  <link name="link_1_clone">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1"/>
      <inertia ixx="0.145833" ixy="0" ixz="0" iyy="0.145833" iyz="0" izz="0.125"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.25" radius="0.3"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.25" radius="0.3"/>
      </geometry>
    </collision>
  </link>

  <!-- Caster Wheel Link -->
  <link name="link_2">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.2"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.2"/>
      </geometry>
    </collision>
  </link>

  <!-- LIDAR LINK -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
      <material name="red">
          <color rgba="1 0 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>


  <!-- ================================= JOINTS ================================= -->

  <!-- Left Wheel Joint -->
  <joint name="link_0_JOINT_0" type="continuous">
    <parent link="link_0"/>
    <child link="link_1"/>
    <origin rpy="1.5707 0 0" xyz="0.45 -0.625029 -0.1"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Right Wheel Joint -->
  <joint name="link_0_JOINT_1" type="continuous">
    <parent link="link_0"/>
    <child link="link_1_clone"/>
    <origin rpy="1.5707 0 0" xyz="0.45 0.625029 -0.1"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Caster Wheel Joint -->
  <joint name="link_0_JOINT_2" type="fixed">
    <parent link="link_0"/>
    <child link="link_2"/>
    <origin rpy="0 0 0" xyz="-0.55 0 -0.2"/>
  </joint>

  <!-- Depth Camera -->
  <link name="depth_camera_link">
    <visual>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
    </collision>
  </link>

  <!-- LIDAR JOINT -->
  <joint name="lidar_joint" type="fixed">
    <parent link="link_0"/>
    <child link="lidar_link"/>
    <!-- 카메라(z≈0.27)보다 높은 위치(z=0.35)로 이동하여 시야 간섭을 회피 -->
    <origin xyz="0 0 0.274738" rpy="0 0 3.1416"/> 
  </joint>

  <joint name="depth_camera_joint" type="fixed">
    <parent link="link_0"/>
    <child link="depth_camera_link"/>
    <origin xyz="0.0 0.0 0.35" rpy="0 0 3.1416"/>
  </joint>

  <gazebo reference="depth_camera_link">
    <sensor name="depth_camera" type="depth">
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>
      <always_on>true</always_on>
      <visualize>true</visualize>

      <plugin name="depth_camera_controller" filename="libgazebo_ros_camera.so">
        <camera_name>depth_camera</camera_name>
        <image_topic_name>image_raw</image_topic_name>
        <camera_info_topic_name>camera_info</camera_info_topic_name>
        <frame_name>depth_camera_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin name="diff_drive_controller" filename="libgazebo_ros_diff_drive.so">
      <!-- 바퀴 조인트 이름 -->
      <left_joint>link_0_JOINT_0</left_joint>
      <right_joint>link_0_JOINT_1</right_joint>

      <!-- 기하적 정보 -->
      <wheel_separation>1.0</wheel_separation> <!-- 바퀴 사이 거리 -->
      <wheel_diameter>0.6</wheel_diameter>     <!-- 바퀴 지름 -->

      <!-- 속도 제한 -->
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>5.0</max_wheel_acceleration>

      <!-- 프레임 정보 -->
      <robot_base_frame>link_0</robot_base_frame>
      <odometry_frame>odom</odometry_frame>

      <!-- TF & Topic 설정 -->
      <publish_odom>true</publish_odom>
      <publish_wheel_tf>true</publish_wheel_tf>
      <publish_odometry_tf>true</publish_odometry_tf>

      <!-- ROS topic -->
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
    </plugin>
  </gazebo>

  <!-- =============================== LIDAR SENSOR PLUGIN =============================== -->
  <gazebo reference="lidar_link">
    <sensor type="ray" name="lidar_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize> <!-- 시뮬레이션에서 레이저 광선을 보이게 함 -->
      <update_rate>10</update_rate> <!-- 1초에 10번 스캔 데이터 업데이트 -->
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples> <!-- 360도 방향으로 360개 샘플 측정 -->
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle> <!-- -180도 -->
            <max_angle>3.14159</max_angle>  <!-- +180도 -->
          </horizontal>
        </scan>
        <range>
          <min>0.15</min> <!-- 최소 측정 거리 -->
          <max>12.0</max> <!-- 최대 측정 거리 -->
          <resolution>0.01</resolution> <!-- 거리 측정 정밀도 -->
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_lidar_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <!-- ROS 2에서는 <namespace>와 <remapping>을, ROS 1에서는 <topicName>과 <frameName>을 주로 사용합니다. -->
          <namespace>/tuto</namespace>
          <remapping>~/out:=scan</remapping> <!-- 최종 토픽: /tuto/scan -->
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name> <!-- TF 프레임 이름 -->
      </plugin>
    </sensor>
  </gazebo>

</robot>
